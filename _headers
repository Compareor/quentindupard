# Cloudflare Pages security + caching headers.
# No build step here, so this file is the only place these can be set.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
  Cross-Origin-Opener-Policy: same-origin

# Fingerprinted by ?v= query strings, so these can be cached hard.
/assets/*
  Cache-Control: public, max-age=604800, must-revalidate

# "!" first: Pages concatenates headers from every matching rule, so without
# it this rule would APPEND to /assets/*'s Cache-Control instead of replacing.
/assets/docs/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000

# Per-visitor and never shared.
/api/*
  Cache-Control: no-store

# The dashboard. robots.txt stops the crawl; this stops the listing if
# something ever links to it, and keeps it out of shared caches.
/admin
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

# IndexNow key. Bing fetches this to verify a submission belongs to the site,
# so it has to stay reachable, plain text, and out of the index.
/c269fe0f232f4c0b98944cadd64fdb68.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
  X-Robots-Tag: noindex
